# Upstream Julia package, used as a read-only reference (separate git repo)
/SNaQ.jl/

# Build output
/build*/
/bin/
/out/
/cmake-build-*/
compile_commands.json
.cache/

# Julia environment lock file (contains machine-specific paths)
/tools/julia/Manifest.toml

# Editors / OS
.DS_Store
.vscode/
.idea/
*.swp

