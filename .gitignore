*.log
*.out
!/benchmarks/history/outputs/**/*.out
*.networks
!/benchmarks/history/outputs/**/*.networks
*_runs/

# Benchmark scratch (history and reports are committed)
/benchmarks/history/outputs/*/*.log

# Python bytecode
__pycache__/
